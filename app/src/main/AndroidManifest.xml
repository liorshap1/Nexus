<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".MyNexusApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexus"
        tools:targetApi="31">
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".home.FriendsActivity"
            android:exported="false" />
        <activity
            android:name=".home.SearchUsersActivity"
            android:exported="false" />
        <activity
            android:name=".home.MainHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Nexus" />
        <activity
            android:name=".authentication.LostPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".authentication.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".authentication.LoginActivity"
            android:exported="false" />

        <service
            android:name=".core.services.NotificationsService"
            android:enabled="true"
            android:foregroundServiceType="remoteMessaging"
            android:exported="true" />
        <service
            android:name=".core.services.FetchUsersService"
            android:enabled="true"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>